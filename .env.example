# Docker images and exposed port
COMPOSE_PROJECT_NAME=business-app-sii
APP_IMAGE_TAG=local
APP_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Local files. These paths are resolved from business-app-sii/.
API_KEY_FILE=./secrets/api-key.txt
SII_PFX_FILE=./secrets/certificado.pfx
SII_PFX_PASSWORD_FILE=./secrets/pfx-password.txt
SII_TEST_ARTIFACTS_DIR=./secure/real-sii-tests/artifacts

# SII certification identity. Never use production in Docker acceptance tests.
SII_CERT_RUT_EMISOR=11111111-1
SII_CERT_RUT_FIRMANTE=11111111-1
SII_CERT_FECHA_RESOLUCION=2026-01-01
SII_CERT_NRO_RESOLUCION=0
SII_CERT_STATUS_SETTLE_MS=5000
SII_CERT_POLL_TIMEOUT_MS=120000
SII_CERT_POLL_INTERVAL_MS=10000
SII_CERT_FACTURA33_TENANT_ID=certification-factura33
SII_CERT_BOLETA39_TENANT_ID=certification-boleta39

# Production custody. Endpoints stay empty when AWS native endpoints are used.
AWS_REGION=us-east-1
AWS_FISCAL_DDB_TABLE=business-app-sii-fiscal
AWS_FISCAL_DDB_ENDPOINT=
AWS_FISCAL_S3_BUCKET=business-app-sii-fiscal
AWS_FISCAL_S3_ENDPOINT=
AWS_FISCAL_S3_PREFIX=fiscal-custody
AWS_FISCAL_S3_FORCE_PATH_STYLE=false
AWS_FISCAL_SSM_ENDPOINT=
AWS_FISCAL_SSM_PREFIX=/business-app-sii/fiscal
