{
  "name": "myfirstapp",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "license": "UNLICENSED",
  "scripts": {
    "build:sii-engine": "corepack pnpm --filter sii-engine build",
    "typecheck:sii-engine": "corepack pnpm --filter sii-engine typecheck",
    "test:sii-engine": "corepack pnpm --filter sii-engine test",
    "prebuild": "corepack pnpm run build:sii-engine",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "corepack pnpm run build:sii-engine",
    "start": "nest start",
    "prestart:dev": "corepack pnpm run build:sii-engine",
    "start:dev": "nest start --watch",
    "prestart:debug": "corepack pnpm run build:sii-engine",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "corepack pnpm run build:sii-engine",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:fiscal": "eslint \"src/fiscal*/**/*.ts\" --fix",
    "pretest": "corepack pnpm run build:sii-engine",
    "test": "jest",
    "pretest:fiscal": "corepack pnpm run build:sii-engine",
    "test:fiscal": "jest --runInBand src/fiscal src/fiscal-documents src/fiscal-polling src/fiscal-rvd src/fiscal-secrets",
    "pretest:watch": "corepack pnpm run build:sii-engine",
    "test:watch": "jest --watch",
    "pretest:cov": "corepack pnpm run build:sii-engine",
    "test:cov": "jest --coverage",
    "pretest:debug": "corepack pnpm run build:sii-engine",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:e2e": "corepack pnpm run build:sii-engine",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "pretest:ministack-custody": "corepack pnpm run build:sii-engine",
    "test:ministack-custody": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-smoke.json --runInBand ./test/fiscal-ministack-custody.smoke-spec.ts",
    "pretest:real-sii": "corepack pnpm run build:sii-engine",
    "test:real-sii": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-smoke.json --runInBand ./test/fiscal-real-sii.smoke-spec.ts",
    "pretest:real-sii:factura33": "corepack pnpm run build:sii-engine",
    "test:real-sii:factura33": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-smoke.json --runInBand ./test/fiscal-real-sii-factura33.smoke-spec.ts",
    "pretest:real-sii:caf33": "corepack pnpm run build:sii-engine",
    "test:real-sii:caf33": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-smoke.json --runInBand ./test/fiscal-real-sii-caf33.smoke-spec.ts",
    "pretest:real-sii:existing-caf": "corepack pnpm run build:sii-engine",
    "test:real-sii:existing-caf": "node scripts/real-sii/test-existing-caf.cjs",
    "pretest:real-sii:factura33:existing-caf": "corepack pnpm run build:sii-engine",
    "test:real-sii:factura33:existing-caf": "node scripts/real-sii/test-existing-caf-factura33.cjs",
    "ministack:start": "node scripts/ministack/start.cjs",
    "ministack:bootstrap": "node scripts/ministack/bootstrap.cjs",
    "prestart:dev:ministack": "corepack pnpm run build:sii-engine",
    "start:dev:ministack": "node scripts/ministack/run-with-env.cjs .env.ministack node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "prestart:ministack": "corepack pnpm run build",
    "start:ministack": "node scripts/ministack/run-with-env.cjs .env.ministack node dist/main"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/client-ssm": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@types/multer": "^2.1.0",
    "axios": "^1.15.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fast-xml-parser": "5.2.5",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "node-forge": "1.3.1",
    "playwright": "^1.60.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sii-engine": "workspace:*",
    "swagger-ui-express": "^5.0.1",
    "xml-crypto": "6.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/../../sii-engine/node_modules"
    ],
    "moduleNameMapper": {
      "^fast-xml-parser$": "<rootDir>/../node_modules/fast-xml-parser",
      "^node-forge$": "<rootDir>/../node_modules/node-forge",
      "^xml-crypto$": "<rootDir>/../node_modules/xml-crypto"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
